# Fichier commun aux services et aux commandes d'administration.
# Copier dans /etc/jobtracker/jobtracker.env, root:jobtracker, permissions 0640.
# Pas de export, substitution shell ni variable faisant référence à une autre.
FLASK_SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_PERSISTANTE
APP_HTTPS=true
DATABASE_PATH=/var/lib/jobtracker/job_tracker.db
SCAN_START_DATE=2026-08-01
APPLICATION_EXPIRY_DAYS=30
GMAIL_CREDENTIALS_FILE=/etc/jobtracker/google-client.json
# Anciens caches : uniquement pour une migration contrôlée, pas pour les nouveaux scans.
GMAIL_TOKEN_FILE=/var/lib/jobtracker/legacy/google-token.json
MICROSOFT_TOKEN_CACHE_FILE=/var/lib/jobtracker/legacy/microsoft-cache.json
MICROSOFT_CLIENT_ID=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
