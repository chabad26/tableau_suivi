# Copier les clés nécessaires dans .env sans écraser sa configuration existante.
# Variables du processus prioritaires ; chemins relatifs à la racine du projet.
MICROSOFT_CLIENT_ID=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_TOKEN_CACHE_FILE=microsoft_token_cache.json
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
DATABASE_PATH=data/job_tracker.db
# Date seule interprétée en Europe/Paris ; offset ISO accepté.
SCAN_START_DATE=2026-08-01
# Choisir une valeur aléatoire privée pour stabiliser les sessions Flask.
FLASK_SECRET_KEY=
# Facultatif : absent = chemins Thunderbird historiques ; {} = désactivé.
# THUNDERBIRD_MAILBOXES='{"Compte local":"/chemin/vers/Inbox"}'
# IMAP générique
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX